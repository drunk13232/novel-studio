{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 600,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "action",
            "python",
            "entry"
          ],
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "kind"
      ],
      "title": "Command",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "title": "Description",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "select"
          ],
          "title": "Type",
          "type": "string"
        },
        "default": {
          "default": "",
          "title": "Default"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Choices",
          "type": "array"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "enum": [
            "experiment",
            "reference",
            "template"
          ],
          "title": "Kind",
          "type": "string"
        },
        "file": {
          "maxLength": 120,
          "minLength": 1,
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "file"
      ],
      "title": "Resource",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "settings",
            "page"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "novel-studio-plugin/1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 80,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "min_app_version": {
      "default": "2.20.0",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Min App Version",
      "type": "string"
    },
    "description": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "author": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "license": {
      "maxLength": 150,
      "minLength": 1,
      "title": "License",
      "type": "string"
    },
    "actions": {
      "items": {
        "type": "string"
      },
      "maxItems": 66,
      "title": "Actions",
      "type": "array"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/Command"
      },
      "maxItems": 30,
      "title": "Commands",
      "type": "array"
    },
    "settings": {
      "items": {
        "$ref": "#/$defs/Option"
      },
      "maxItems": 30,
      "title": "Settings",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "maxItems": 20,
      "title": "Resources",
      "type": "array"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 60,
      "title": "Files",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license"
  ],
  "title": "Manifest",
  "type": "object"
}